{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegis-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Build the Go image from repository root (parent of cloudflare/).
  "containers": [
    {
      "class_name": "AegisContainer",
      "scheduling_policy": "durable_object",
      "max_instances": 3,
      "images": {
        "base": {
          "dockerfile": "../Dockerfile.aegis",
          "context": ".."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AegisContainer",
        "name": "AEGIS"
      }
    ]
  },
  "exports": {
    "AegisContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
