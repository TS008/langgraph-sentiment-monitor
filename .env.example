# Copy to .env and fill in values (never commit .env)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional: comma-separated RSS feed URLs for the crawler
AEGIS_RSS_FEEDS=https://hnrss.org/frontpage

# HTTP server (cmd/aegis serve)
AEGIS_HTTP_ADDR=:8080

# Pipeline tuning
AEGIS_CRAWL_PARALLELISM=4
AEGIS_LLM_TIMEOUT_SEC=60
AEGIS_APPROVAL_TIMEOUT_SEC=5
