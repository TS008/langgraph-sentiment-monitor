# Copy to .env and fill in values (never commit .env)

# OpenCode Go — OpenAI-compatible LLM (default for AEGIS Go stack)
OPENCODE_GO_API_KEY=your_opencode_go_api_key_here
# Alias:
# AEGIS_LLM_API_KEY=your_opencode_go_api_key_here
AEGIS_LLM_BASE_URL=https://opencode.ai/zen/go/v1
AEGIS_LLM_MODEL=mimo-v2.6-flash
# OpenCode Go: x-opencode-session + User-Agent are set automatically per pipeline run (see REFACTOR.md).

# Optional: comma-separated RSS feed URLs for the crawler
AEGIS_RSS_FEEDS=https://hnrss.org/frontpage

# NewsNow Chinese hot lists — self-hosted recommended (docker compose up -d newsnow)
# AEGIS_NEWSNOW_DISABLE=true
AEGIS_NEWSNOW_BASE_URL=http://127.0.0.1:4444
# Optional public instance (often Cloudflare 403 outside China): https://newsnow.busiyi.world
# Comma-separated list ids (see github.com/ourongxing/newsnow); use "none" to disable
AEGIS_NEWSNOW_IDS=weibo,zhihu,baidu,douyin,toutiao,thepaper
AEGIS_NEWSNOW_MIN_INTERVAL_SEC=300

# HTTP server (cmd/aegis serve). Cloudflare Containers set PORT=8080 automatically.
AEGIS_HTTP_ADDR=:8080
# PORT=8080

# Queue: memory (default, no Redis) | asynq (requires Redis + worker)
AEGIS_QUEUE_MODE=memory
AEGIS_REDIS_URL=redis://127.0.0.1:6379

# Crawler: set true or pass --js on CLI for chromedp (needs Chrome/Chromium)
AEGIS_CRAWL_JS_RENDER=false
# SSRF guard for user-supplied html_url: private, loopback and metadata addresses are
# blocked. Allow specific internal targets via CIDRs, or everything for local dev.
# AEGIS_FETCH_ALLOW_CIDRS=10.20.0.0/16,192.168.1.50
# AEGIS_FETCH_ALLOW_PRIVATE=false

# Pipeline tuning
AEGIS_CRAWL_PARALLELISM=4
AEGIS_LLM_TIMEOUT_SEC=120
AEGIS_RUN_TIMEOUT_SEC=900
AEGIS_APPROVAL_TIMEOUT_SEC=5
# Finished runs kept in memory (oldest evicted first)
AEGIS_MAX_RETAINED_RUNS=200
# In-process runs executing at once; extra POST /api/v1/runs get 429
AEGIS_MAX_CONCURRENT_RUNS=4

# Social stubs (OAuth follow-up — not required for RSS MVP)
# X_API_BEARER_TOKEN=
# WEIBO_APP_KEY=
# WEIBO_APP_SECRET=
